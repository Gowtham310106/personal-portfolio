# Server-side only — set these in Vercel → Settings → Environment Variables.
# Never commit real values.

# Zoho mailbox that sends and receives enquiries
ZOHO_USER="hello@buildfastweb.in"
ZOHO_PASS="your-zoho-app-specific-password"

# Optional
# ZOHO_HOST="smtp.zoho.in"      # or smtp.zoho.com — match your Zoho region
# LEAD_TO="hello@buildfastweb.in"

# Optional: use a third-party form service instead of /api/lead
# VITE_LEAD_ENDPOINT="https://formspree.io/f/xxxxxxx"
